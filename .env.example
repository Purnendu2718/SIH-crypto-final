# CryptoTrace Sentinel (SIH26183) — Environment Configuration Template
# Copy this file to .env for local deployment. Never commit real keys.

# Supabase Auth & Storage (https://supabase.com)
SUPABASE_URL=https://placeholder-project.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key-eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-eyJhbGciOi...

# Database Connection (Supabase Postgres or local PostgreSQL)
# For local dev without Postgres, the app falls back to SQLite (sqlite:///./cryptotrace_dev.db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cryptotrace

# Application Settings
ENVIRONMENT=development
PORT=8000
RATE_LIMIT_ENABLED=true
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost

# Blockchain Providers & Multi-Chain Forensic Engine
# DEMO_MODE: When true, simulated data is returned with a visible banner if live network fails.
DEMO_MODE=false
LIVE_MODE=false

# Bitcoin (mempool.space Esplora API, with blockstream.info fallback)
MEMPOOL_API_URL=https://mempool.space/api

# EVM Chains (Ethereum, Polygon, Arbitrum, Optimism, BSC, Base)
EVM_RPC_URL=https://ethereum-rpc.publicnode.com
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
POLYGON_RPC_URL=https://polygon-rpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BSC_RPC_URL=https://binance.llamarpc.com
ETHERSCAN_API_KEY=

# TRON (TronGrid API)
TRON_RPC_URL=https://api.trongrid.io
TRONGRID_API_KEY=
TRON_PRO_API_KEY=

# Solana (JSON-RPC)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# UTXO Chains via Blockchair (Litecoin, Dogecoin, Dash, Zcash, Bitcoin Cash)
BLOCKCHAIR_API_KEY=

# Frontend API URL
VITE_API_URL=/api

# Phase 8E: GraphSense Worldwide Labels & Live Entity Lookup
GRAPHSENSE_API_URL=https://api.ikna.io
GRAPHSENSE_API_KEY=

# Telegram Webhook (Golden Hour Watchlist Alerting)
ENABLE_TELEGRAM_WEBHOOK=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Co-pilot (Arjuna)
GEMINI_API_KEY=

